{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cogitorium",
  "version": "0.4.1",
  "identifier": "com.necriesa.cogitorium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "data-stylus",
        "title": "Data Stylus",
        "width": 380,
        "height": 620,
        "minWidth": 320,
        "minHeight": 420,
        "x": 60,
        "y": 80,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "chrono-siphon",
        "title": "Chrono-Siphon",
        "width": 300,
        "height": 600,
        "x": 470,
        "y": 80,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
