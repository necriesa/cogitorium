# Optional, for development: copy to .env (gitignored).
# The app normally asks for the vault folder on first run and remembers it;
# this is only used when no folder has been saved yet.

# Absolute path to your Obsidian vault.
DARK_CELLS_VAULT=C:\path\to\your\vault

# Optional: where logs go, relative to the vault. Default: Sources/Journal/Widgets
# DARK_CELLS_LOG_DIR=Sources/Journal/Widgets
